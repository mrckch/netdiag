[Unit]
Description=netdiag - lokaler Netzwerk-Port-Tester
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/netdiag
# Default: Dashboard nur auf localhost (API hat keine Auth und kann SNMP-Writes
# auslösen). Für Fernzugriff im Management-VLAN: NETDIAG_HOST=0.0.0.0 setzen.
Environment=NETDIAG_HOST=127.0.0.1
Environment=NETDIAG_PORT=8642
ExecStart=/opt/netdiag/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=3
# Braucht CAP_NET_RAW für Scapy-Sniffing (VLAN/EAPOL/STP/CDP) und nmap.
# Root ist hier pragmatisch (dediziertes Diagnosegerät, siehe CLAUDE.md).
User=root

[Install]
WantedBy=multi-user.target
